@model HeroesFluent.Models.Equipo

@{
    ViewData["Title"] = "Editar equipo";
}

<div class="form-page">
    <h1>Editar equipo</h1>
    <hr />
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FechaFundacion" class="form-label">Fecha y hora de fundación</label>
            <input asp-for="FechaFundacion" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
            <span asp-validation-for="FechaFundacion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Presupuesto" class="form-label">Presupuesto</label>
            <input asp-for="Presupuesto" class="form-control" min="0" step="0.01" />
            <span asp-validation-for="Presupuesto" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver a equipos</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
